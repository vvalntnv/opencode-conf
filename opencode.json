{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-gemini-auth@latest",
        "opencode-wakatime",
        "oh-my-opencode-slim",
        "@dietrichgebert/ponytail"
    ],
    "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow",
        "doom_loop": "ask",
        "external_directory": "ask"
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "ctx7sk-c2992a73-45eb-42c5-8b9e-9eae3d4a5587"
            }
        },
        "codegraph": {
            "type": "local",
            "command": [
                "codegraph",
                "serve",
                "--mcp"
            ],
            "enabled": true
        }
    },
    "agent": {
        "explore": {
            "disable": true
        },
        "general": {
            "disable": true
        }
    },
    "lsp": true
}
