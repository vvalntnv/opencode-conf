{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-gemini-auth@latest",
        "opencode-wakatime",
        "oh-my-opencode-slim",
        "@dietrichgebert/ponytail"
    ],
    "permission": {
        "edit": "ask",
        "bash": {
            "*": "ask",
            "git push": "deny",
            "git push *": "deny",
            "git reset --hard": "deny",
            "git reset --hard *": "deny",
            "git clean *": "deny",
            "psql": "deny",
            "psql *": "deny",
            "mysql": "deny",
            "mysql *": "deny",
            "sqlite": "deny",
            "sqlite *": "deny",
            "sqlite3": "deny",
            "sqlite3 *": "deny",
            "rm *": "deny",
            "rmdir *": "deny",
            "sudo *": "deny",
            "dd *": "deny"
        },
        "webfetch": "allow",
        "doom_loop": "ask",
        "external_directory": "deny"
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "codegraph": {
            "type": "local",
            "command": [
                "codegraph",
                "serve",
                "--mcp"
            ],
            "enabled": true
        }
    },
    "agent": {
        "explore": {
            "disable": true
        },
        "general": {
            "disable": true
        }
    },
    "lsp": true
}
